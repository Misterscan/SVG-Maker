{
  "name": "svg-maker",
  "version": "1.1.1",
  "description": "A workspace for generated SVGs using Sesi built-in functions from the std/draw library.",
  "main": "@misterscan/sesi",
  "bin": {
    "sesi": "@misterscan/sesi"
  },
  "license": "MIT",
  "author": "misterscan",
  "private": true,
  "scripts": {
    "sesi": "sesi",
    "local": "sesi -l",
    "start": "sesi -l ui.sesi",
    "svg-gen": "sesi -l svg-gen.sesi",
    "eval": "sesi -e",
    "help": "sesi -h",
    "lint": "sesi bin/lint.sesi",
    "encrypt": "sesi -enc",
    "decrypt": "sesi -dec"
  }
}
