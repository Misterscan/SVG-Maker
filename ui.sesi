allow "helpers/safe" in as Safe
allow "SesiDo/build" in with {createSVG}

set_alias("SesiDo-Flash", "gemini-3-flash-preview")

let PORT = 8080

fn extractGeneratedSvgPath(outputText) {
  if outputText == null || outputText == "" {
    return ""
  }

  let outputIndex = index_of(outputText, "output=")
  if outputIndex < 0 {
    return ""
  }

  let remainder = slice(outputText, outputIndex + 7, len(outputText))
  let endIndex = index_of(remainder, ";")
  if endIndex < 0 {
    endIndex = index_of(remainder, "\n")
  }
  if endIndex >= 0 {
    remainder = slice(remainder, 0, endIndex)
  }

  remainder = trim(remainder)
  if remainder == "" {
    return ""
  }
  return remainder
}

async fn handleRequest(req) {
  show "Request:" req.method req.path
  
  if req.method == "GET" && req.path == "/" {
    try {
      let html = Safe.readFile("assets/index.html")
      return {
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": html
      }
    } catch (err) {
      return {
        "status": 500,
        "body": "Error loading svg_studio.html: " + str(err)
      }
    }
  }

  if req.method == "POST" && req.path == "/render" {
    try {
      let payload = from_json(req.body)
      let code = payload["code"]
      let width = payload["width"]
      let height = payload["height"]
      
      let finalCode = code
      if !contains(code, "std/draw") {
        finalCode = "allow \"std/draw\" in with Draw\n" + finalCode
      }
      
      // Append render block to extract the SVG from standard output
      finalCode = finalCode + "\n\ntry {\n  show \"===SVG_START===\"\n  show Draw.render(" + str(width) + ", " + str(height) + ")\n  show \"===SVG_END===\"\n} catch (err) {\n  show \"Render failed:\" err\n}\n"
      
      let tempFile = "temp_draw.sesi"
      Safe.writeFile(tempFile, finalCode)
      
      let out = ""
      try {out = sesi(tempFile, true); trash(tempFile, true)} catch (e) {}
      
      let svg = ""
      let error = null
      
      if contains(out, "===SVG_START===") && contains(out, "===SVG_END===") {
        let parts = split(out, "===SVG_START===")
        if len(parts) > 1 {
          let innerParts = split(parts[1], "===SVG_END===")
          if len(innerParts) > 0 {
            svg = trim(innerParts[0])
          }
        }
      } else {
        error = "Output did not contain valid SVG markers. Execution output:\n" + out
      }
      
      if contains(out, "Error at line") || contains(out, "Exception") || contains(out, "Undefined") {
        error = out
      }
      
      let cleanOut = out
      if contains(cleanOut, "===SVG_START===") {
        let parts = split(cleanOut, "===SVG_START===")
        let endParts = split(cleanOut, "===SVG_END===")
        let before = parts[0]
        let after = ""
        if len(endParts) > 1 {
          after = endParts[1]
        }
        cleanOut = before + "[SVG XML Rendered]" + after
      }
      
      if error != null {
        return {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": to_json({
            "error": error,
            "output": cleanOut
          })
        }
      }
      
      return {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": to_json({
          "svg": svg,
          "output": cleanOut
        })
      }
    } catch (err) {
      return {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": to_json({
          "error": "Failed to run Sesi script: " + str(err)
        })
      }
    }
  }

  if req.method == "POST" && req.path == "/generate-svg" {
    try {
      let payload = from_json(req.body)
      let description = ""
      if payload["description"] != null {
        description = trim(payload["description"])
      }

      if description == "" {
        return {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": to_json({
            "error": "Please provide an SVG description."
          })
        }
      }

      let out = ""
      try {
        out = createSVG({"description": description})
      } catch (e) {
        out = "Error running createSVG: " + str(e)
      }

      let svg = ""
      let outputPath = extractGeneratedSvgPath(out)

      if outputPath != "" {
        svg = Safe.readFile(outputPath)
      }

      if svg == null || svg == "" {
        return {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": to_json({
            "error": "Generated SVG file was not found or was empty.",
            "output": out,
            "outputPath": outputPath
          })
        }
      }

      return {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": to_json({
          "svg": svg,
          "output": out,
          "outputPath": outputPath
        })
      }
    } catch (err) {
      return {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": to_json({
          "error": "Failed to generate SVG: " + str(err)
        })
      }
    }
  }
  

  
  return {
    "status": 404,
    "body": "Not found"
  }
}

show "=========================================================="
show "🚀 Sesi SVG Studio Server is starting..."
show "=========================================================="

let server = listen(PORT, handleRequest)
try {
  open("http://localhost:" + str(PORT))
} catch (e) {
  show "Error opening browser:" e
}

let end = input("Press Enter to stop the server...\n")
server.close(end)