allow "std/draw" in as Draw
allow "std/math" in as Math

// EDITABLE PARAMETERS — change these values and rerun the script.
// clockText: time displayed in the laptop's menu bar. Keep it to five characters.
// moonX: horizontal position of the crescent in the right windowpane (700–895).
// starCount: number of stars scattered across the window; use 0 for a starless sky.
// nightSeed: any integer; changes the star positions, rooftops, and lit city windows.
// lampGlow: warmth and strength of the lamp's light spill, from 0 to 1.
// screenGlow: strength of the laptop's blue light spill, from 0 to 1.
// catCoat, catShadow, catStripe: hex colors for the cat's lit fur, shaded fur, and markings.
// showSteam: set to false to remove the curls of steam above the mug.
let clockText = "01:47"
let moonX = 808
let starCount = 48
let nightSeed = 26
let lampGlow = 0.72
let screenGlow = 0.78
let catCoat = "#e6a365"
let catShadow = "#a95848"
let catStripe = "#834343"
let showSteam = true

Draw.gradient("linear","wall",[{offset:"0%",color:"#19192f"},{offset:"100%",color:"#392639"}],{x1:"5%",y1:"0%",x2:"90%",y2:"100%"})
Draw.gradient("linear","night",[{offset:"0%",color:"#111b3a"},{offset:"65%",color:"#29385e"},{offset:"100%",color:"#77617c"}],{x1:"0%",y1:"0%",x2:"0%",y2:"100%"})
Draw.gradient("linear","wood",[{offset:"0%",color:"#a26857"},{offset:"56%",color:"#744556"},{offset:"100%",color:"#472d42"}],{x1:"10%",y1:"0%",x2:"82%",y2:"100%"})
Draw.gradient("linear","display",[{offset:"0%",color:"#20254f"},{offset:"100%",color:"#326784"}],{x1:"15%",y1:"0%",x2:"85%",y2:"100%"})
Draw.gradient("linear","metal",[{offset:"0%",color:"#aeb5cf"},{offset:"55%",color:"#646681"},{offset:"100%",color:"#464358"}],{x1:"0%",y1:"0%",x2:"0%",y2:"100%"})
Draw.gradient("linear","fur",[{offset:"0%",color:catCoat},{offset:"50%",color:catCoat},{offset:"100%",color:catShadow}],{x1:"0%",y1:"10%",x2:"90%",y2:"100%"})
Draw.gradient("linear","shade",[{offset:"0%",color:"#a34f47"},{offset:"58%",color:"#e29463"},{offset:"100%",color:"#ffcb8c"}],{x1:"15%",y1:"0%",x2:"80%",y2:"100%"})
Draw.gradient("radial","amber",[{offset:"0%",color:"#ffc17f",opacity:0.78},{offset:"46%",color:"#e89057",opacity:0.32},{offset:"100%",color:"#e89057",opacity:0}],{cx:"50%",cy:"50%",r:"50%"})
Draw.gradient("radial","blue",[{offset:"0%",color:"#96ddff",opacity:0.58},{offset:"62%",color:"#71b2ee",opacity:0.20},{offset:"100%",color:"#71b2ee",opacity:0}],{cx:"50%",cy:"50%",r:"50%"})
Draw.gradient("radial","moonHalo",[{offset:"0%",color:"#e1d0ff",opacity:0.31},{offset:"100%",color:"#e1d0ff",opacity:0}],{cx:"50%",cy:"50%",r:"50%"})
Draw.raw("<defs><clipPath id='glass'><rect x='329' y='85' width='616' height='357' rx='74'/></clipPath><pattern id='wallFleck' width='59' height='47' patternUnits='userSpaceOnUse'><path d='M9 17h1m39 9h1M22 39h1M41 6h1M3 42h1' stroke='#f7c9ad' stroke-width='1' stroke-linecap='round' opacity='0.12'/><path d='M31 13h2m13 30h1M14 31h1' stroke='#100f20' stroke-width='1' opacity='0.25'/></pattern><clipPath id='screenClip'><rect x='391' y='347' width='321' height='183' rx='7'/></clipPath></defs>")

// Plaster, tall window, and the neighborhood beyond the glass.
