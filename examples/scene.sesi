// Save SVG file
show "Saving SVG file..."
let dirpath = "playground/svgs/"
let filepath = dirpath + "laptop_late_night_v2.svg"
fn saveSVG() { return Draw.save_svg(filepath, 1200, 800) }

try {
  if !exists(dirpath) {
    make_dir(dirpath)
    show "Directory verified/created:" dirpath
  }
  saveSVG | retry({max_retries: 2, initial_delay: 1000})
  show "Successfully generated and saved SVG to:" filepath
} catch (err) { show "Error writing SVG file:" str(err) }